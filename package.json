{
  "name": "intake",
  "version": "1.0.0",
  "description": "AI Revenue Researcher powered by OpenClaw",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "openclaw-daemon"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:daemon\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:daemon": "cd openclaw-daemon && npm run dev",
    "build": "npm run build:backend && npm run build:frontend && npm run build:daemon",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:daemon": "cd openclaw-daemon && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/react": "^3.0.142"
  }
}
